#!/bin/bash
# LIGHTNING-KERNEL-BUILD

# Variables
DIR="$(pwd)"

PARENT_DIR="$(pwd)"

echo "Cloning dependencies"
git clone --depth=1 --branch stock_a90 https://github.com/young0103/samsung_a90_kernel kernel
cd kernel 
git clone --depth=1 --branch android-11.0.0_r48 https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9 aarch64-linux-android-4.9
git clone --depth=1  https://github.com/prorooter007/android_prebuilts_clang_host_linux-x86_clang-6877366 clang-r383902
git clone --depth=1 https://github.com/osm0sis/AnyKernel3 AnyKernel3
echo "Done"
KERNEL_DIR=$(pwd)
OUT_DIR="$(pwd)/out"
REPACK_DIR="${KERNEL_DIR}/AnyKernel3"
IMAGE="${KERNEL_DIR}/arch/arm64/boot/Image"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"


export PLATFORM_VERSION=11
export ANDROID_MAJOR_VERSION=r
export CROSS_COMPILE="$(pwd)/aarch64-linux-android-4.9/bin/aarch64-linux-android-"
export CLANG_TRIPLE="$(pwd)/clang-r383902/bin/aarch64-linux-gnu-"
export ARCH=arm64
export SEC_BUILD_CONF_VENDOR_BUILD_OS=13
export LINUX_GCC_CROSS_COMPILE_PREBUILTS_BIN="$(pwd)/aarch64-linux-android-4.9/bin"
export CLANG_PREBUILT_BIN="$(pwd)/clang-r383902/bin"
export PATH=$PATH:$LINUX_GCC_CROSS_COMPILE_PREBUILTS_BIN:$CLANG_PREBUILT_BIN
export LLVM=1
#KERNEL_MAKE_ENV="LOCALVERSION=-Lightning-V2.5"

# Color
ON_BLUE=`echo -e "\033[44m"`	# On Blue
BRED=`echo -e "\033[1;31m"`	# Bold Red
BBLUE=`echo -e "\033[1;34m"`	# Bold Blue
BGREEN=`echo -e "\033[1;32m"`	# Bold Green
UNDER_LINE=`echo -e "\e[4m"`	# Text Under Line
STD=`echo -e "\033[0m"`		# Text Clear
 
build_kernel() {
    cd "$KERNEL_DIR"
    export ARCH=arm64 CC=clang CROSS_COMPILE=aarch64-linux-android- LLVM=1

    DEFCONFIG=r3q_kor_single_defconfig

    # ── 1) defconfig 생성: O= 없이 수행 ─────────────────────────
    echo "${BGREEN}[1/3] generate .config (${DEFCONFIG})${STD}"
    make "$DEFCONFIG"

    # out 디렉터리 준비 및 .config 복사
    mkdir -p "$OUT_DIR"
    cp .config "$OUT_DIR/"

    # ── 2) 실제 컴파일: out‑of‑tree ────────────────────────────
    echo "${BGREEN}[2/3] compile kernel (O=$OUT_DIR)${STD}"
    make -C "$KERNEL_DIR" O="$OUT_DIR" -j"$(nproc)"

    # ── 3) Image·dtb 패킹 등 후처리 ────────────────────────────
    IMG="$OUT_DIR/arch/arm64/boot/Image"
    if [ ! -f "$IMG" ]; then
        echo "[ERROR] Image 생성 실패"; exit 1; fi

    cp "$IMG" "$OUT_DIR/"
    DTB_DIR="$OUT_DIR/arch/arm64/boot/dts"
    tools/mkdtimg cfg_create "$OUT_DIR/dtb.img"  dt.configs/exynos2100.cfg -d "${DTB_DIR}/exynos"
    tools/mkdtimg cfg_create "$OUT_DIR/dtbo.img" dt.configs/r9s.cfg        -d "${DTB_DIR}/samsung/r9s"
    echo "${BGREEN}[3/3] build done${STD}"
}

gsi_kernel(){
  echo "${BGREEN}***** Apply GSI patch *****${STD}"

  cd $KERNEL_DIR
  git apply gsi-commits.patch
}

build_kernel

gsi_kernel

build_kernel