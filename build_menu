#!/bin/bash
# LIGHTNING-KERNEL-BUILD (Method A: use `renovation/` for DTB/DTBO)

set -euo pipefail


#
# ─── VARIABLES ────────────────────────────────────────────────────────────────
#
DEVICE_CODENAME=r3q
DEFCONFIG=r3q_kor_single_defconfig
DT_CFG=dt.configs/r9s.cfg
GSI_PATCH=gsi-commits.patch

KERNEL_REPO=https://github.com/young0103/samsung_a90_kernel
KERNEL_BRANCH=stock_a90
GCC_PREBUILT=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9
GCC_BRANCH=android-11.0.0_r48
CLANG_PREBUILT=https://github.com/prorooter007/android_prebuilts_clang_host_linux-x86_clang-6877366
CLANG_DIR=clang-r383902
ANYKERNEL_REPO=https://github.com/osm0sis/AnyKernel3

# Directory layout
ROOT_DIR="$(pwd)"
KERNEL_DIR="${ROOT_DIR}/kernel"
OUT_DIR="${KERNEL_DIR}/out"
REPACK_DIR="${KERNEL_DIR}/AnyKernel3"
DTB_DIR="${KERNEL_DIR}/arch/arm64/boot/dts"
IMAGE_PATH="${KERNEL_DIR}/arch/arm64/boot/Image"

# build tools
MAKE_ARGS="-j$(nproc)"

#
# ─── COLORS ───────────────────────────────────────────────────────────────────
#
BGREEN=$(echo -e "\033[1;32m")
STD=$(echo -e "\033[0m")

#
# ─── CLONE DEPENDENCIES ───────────────────────────────────────────────────────
#
echo "${BGREEN}>>> Cloning dependencies${STD}"
git clone --depth=1 --branch ${KERNEL_BRANCH} ${KERNEL_REPO} kernel
cd kernel
git clone --depth=1 --branch ${GCC_BRANCH} ${GCC_PREBUILT} aarch64-linux-android-4.9
git clone --depth=1       ${CLANG_PREBUILT}   ${CLANG_DIR}
git clone --depth=1       ${ANYKERNEL_REPO}   AnyKernel3
echo "${BGREEN}>>> Done cloning${STD}"

#
# ─── EXPORT ENVIRONMENT ───────────────────────────────────────────────────────
#
export PATH="$PATH:${KERNEL_DIR}/aarch64-linux-android-4.9/bin:${KERNEL_DIR}/${CLANG_DIR}/bin"
export CROSS_COMPILE="${KERNEL_DIR}/aarch64-linux-android-4.9/bin/aarch64-linux-android-"
export CLANG_TRIPLE="${KERNEL_DIR}/${CLANG_DIR}/bin/aarch64-linux-gnu-"
export ARCH=arm64
export SRCARCH=arm64
export LLVM=1

#
# ─── BUILD FUNCTION ──────────────────────────────────────────────────────────
#
build_kernel() {
  echo "${BGREEN}>>> Compiling kernel (${DEFCONFIG})${STD}"
  mkdir -p "${OUT_DIR}"

  # 1) defconfig & build
  make -C "${KERNEL_DIR}" \
       ARCH=arm64 SRCARCH=arm64 \
       KBUILD_DEFCONFIG=r3q_kor_single \
       defconfig

  make -C "${KERNEL_DIR}" ${MAKE_ARGS}

  echo ">>> Now building with ${DEFCONFIG}"

  # 2) copy Image
  if [ -f "${IMAGE_PATH}.gz" ]; then
    cp "${IMAGE_PATH}.gz" "${OUT_DIR}/Image.gz"
  fi
  if [ -f "${IMAGE_PATH}" ]; then
    cp "${IMAGE_PATH}" "${OUT_DIR}/Image"
  fi

  # 3) DTB / DTBO (use 'renovation' folder)
  echo "${BGREEN}>>> Creating DTB and DTBO using '${DT_CFG}'${STD}"
  "${KERNEL_DIR}/tools/mkdtimg" cfg_create "${OUT_DIR}/dtb.img"  "${KERNEL_DIR}/${DT_CFG}" \
    -d "${DTB_DIR}/samsung/renovation"
  "${KERNEL_DIR}/tools/mkdtimg" cfg_create "${OUT_DIR}/dtbo.img" "${KERNEL_DIR}/${DT_CFG}" \
    -d "${DTB_DIR}/samsung/renovation"

  # 4) AnyKernel3 packaging
  echo "${BGREEN}>>> Packaging AnyKernel3${STD}"
  pushd "${REPACK_DIR}" >/dev/null
    git reset --hard

    cp "${OUT_DIR}/Image"    zImage
    cp "${OUT_DIR}/dtbo.img" dtbo.img

    # update anykernel.sh metadata
    sed -i \
      -e "s/ExampleKernel by osm0sis/${DEVICE_CODENAME}_kernel by prorooter007/g" \
      -e "s/=maguro/=r9s/g" \
      -e "/toroplus|toro|tuna/s/^/#/g" \
      anykernel.sh

    ZIP_NAME="${DEVICE_CODENAME}_kernel.zip"
    zip -r9 "${ZIP_NAME}" * -x .git README.md *placeholder

    # optional: upload (uncomment & adjust if you want auto-upload)
    # curl https://bashupload.com/"${ZIP_NAME}" --data-binary @"${ZIP_NAME}"
  popd >/dev/null

  echo "${BGREEN}>>> Build and packaging complete: ${REPACK_DIR}/${ZIP_NAME}${STD}"
}

#
# ─── GSI PATCH ────────────────────────────────────────────────────────────────
#
apply_gsi_patch() {
  echo "${BGREEN}>>> Applying GSI patch (${GSI_PATCH})${STD}"
  cd "${KERNEL_DIR}"
  git apply "${GSI_PATCH}"
}

#
# ─── MAIN ────────────────────────────────────────────────────────────────────
#
build_kernel
apply_gsi_patch
build_kernel

echo "${BGREEN}>>> All done!${STD}"
